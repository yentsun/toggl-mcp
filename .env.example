# Required: Toggl Track API token (https://track.toggl.com/profile -> "Click to reveal")
TOGGL_API_KEY=your_api_key_here

# Optional: default workspace id used by workspace-scoped tools
# TOGGL_DEFAULT_WORKSPACE_ID=123456

# Optional: metadata cache TTL in milliseconds (default: 3600000)
# TOGGL_CACHE_TTL=3600000
