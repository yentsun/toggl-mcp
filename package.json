{
  "name": "yt-toggl-mcp",
  "version": "0.2.0",
  "description": "Self-hosted MCP server for Toggl Track (API v9)",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "yt-toggl-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "format": "prettier --write src/**/*.ts tests/**/*.ts"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "toggl",
    "time-tracking"
  ],
  "author": "yentsun",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yentsun/toggl-mcp.git"
  },
  "homepage": "https://github.com/yentsun/toggl-mcp#readme",
  "bugs": {
    "url": "https://github.com/yentsun/toggl-mcp/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.1.0",
    "tsx": "^4.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  }
}
